APP_NAME="SmileCare Dental"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database (matches docker-compose.yml) ─────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dental_db
DB_USERNAME=root
DB_PASSWORD=

# ── Cache & Queue ─────────────────────────────────────────
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# ── Redis ─────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Mail (Mailpit for dev) ────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@smilecare.ph"
MAIL_FROM_NAME="${APP_NAME}"

# ── File Storage ──────────────────────────────────────────
FILESYSTEM_DISK=local

# ── Vite ──────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
